{
  "attributes": [
    {
      "name": "username",
      "validations": {
        "length": {
          "min": 3,
          "max": 100
        },
        "username-prohibited-characters": {}
      },
      "permissions": {
        "view": [
          "admin",
          "user"
        ],
        "edit": [
          "admin",
          "user"
        ]
      }
    },
    {
      "name": "email",
      "validations": {
        "email": {},
        "length": {
          "max": 254
        }
      },
      "required": {
        "roles": [
          "user"
        ]
      },
      "permissions": {
        "view": [
          "admin",
          "user"
        ],
        "edit": [
          "admin",
          "user"
        ]
      }
    },
    {
      "name": "firstName",
      "validations": {
        "length": {
          "max": 150
        }
      },
      "permissions": {
        "view": [
          "admin",
          "user"
        ],
        "edit": [
          "admin",
          "user"
        ]
      }
    },
    {
      "name": "lastName",
      "validations": {
        "length": {
          "max": 150
        }
      },
      "permissions": {
        "view": [
          "admin",
          "user"
        ],
        "edit": [
          "admin",
          "user"
        ]
      }
    },
    {
      "name": "auth_version",
      "multivalued": false,
      "validations": {
        "pattern": {
          "pattern": "[0-9]{1,19}"
        }
      },
      "permissions": {
        "view": [
          "admin"
        ],
        "edit": [
          "admin"
        ]
      }
    }
  ]
}
