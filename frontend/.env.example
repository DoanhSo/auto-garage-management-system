# Public browser values only. Never put signing keys, passwords or provider tokens here.
VITE_API_BASE_URL=/api/v1
VITE_NOTIFICATION_POLL_MS=60000
VITE_REQUEST_TIMEOUT_MS=20000
VITE_KEYCLOAK_CLIENT_ID=autogarage-frontend
# Token requests use the /realms proxy. Browser redirects use Keycloak's actual public realm URL;
# it must match the configured issuer/redirect URIs. Relative public redirects need a complete
# same-origin proxy for Keycloak realms/resources and a matching Keycloak public hostname.
VITE_KEYCLOAK_ISSUER=/realms/autogarage-realm
VITE_KEYCLOAK_PUBLIC_ORIGIN=http://localhost:8081/realms/autogarage-realm
VITE_PKCE_SESSION_MAX_AGE_MS=600000
# Enable only after the Google identity provider is configured in Keycloak.
VITE_GOOGLE_LOGIN_ENABLED=false
# Local development proxy; not included in the browser bundle.
DEV_API_PROXY=http://127.0.0.1:8080
DEV_KEYCLOAK_PROXY=http://127.0.0.1:8081
