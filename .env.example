# Local Docker credentials only. Override these for other environments.
DB_PASSWORD=autogarage_local
MYSQL_ROOT_PASSWORD=root_local
MYSQL_PORT=3307
# Spring Boot reads DB_URL, DB_USERNAME, DB_PASSWORD from process environment.
# Copying this file to .env configures Docker Compose; export variables for Java separately.
DB_URL=jdbc:mysql://localhost:3307/autogarage?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=autogarage
SERVER_PORT=8080
