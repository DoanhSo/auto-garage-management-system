# Template only. Generate local random secrets with scripts/initialize-local-env.ps1.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3307
KEYCLOAK_PORT=8081
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_ADMIN_ENABLED=true
KEYCLOAK_ADMIN_SERVER_URL=http://localhost:8081
KEYCLOAK_ADMIN_REALM=autogarage-realm
KEYCLOAK_ADMIN_CONNECT_TIMEOUT=5s
KEYCLOAK_ADMIN_REQUEST_TIMEOUT=10s
# Spring Boot reads DB_URL, DB_USERNAME, DB_PASSWORD and Keycloak OIDC settings from process environment.
# Copying this file to .env configures Docker Compose; export variables for Java separately.
DB_URL=jdbc:mysql://localhost:3307/autogarage?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=autogarage
SERVER_PORT=8080
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/autogarage-realm
KEYCLOAK_JWKS_URI=http://localhost:8081/realms/autogarage-realm/protocol/openid-connect/certs
AUTH_JWT_AUDIENCE=autogarage-api
AUTH_JWT_CLOCK_SKEW=0s
AUTH_CORS_ORIGINS=http://localhost:5173
AUTH_BOOTSTRAP_ENABLED=false
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_FULL_NAME=
AUTH_BOOTSTRAP_IDENTITY_ID=
OPENAPI_ENABLED=true
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_REMINDERS_ENABLED=false
NOTIFICATION_BATCH_SIZE=20
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_LEASE=2m
NOTIFICATION_RETRY_DELAY=5m
GARAGE_TIME_ZONE=Asia/Bangkok
NOTIFICATION_REMINDER_DAYS=15
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
NOTIFICATION_SMS_ENABLED=false
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=

# Validated runtime policies (safe defaults; no secrets).
AUTH_PASSWORD_MIN_LENGTH=12
PAGINATION_DEFAULT_SIZE=20
PAGINATION_MAX_SIZE=100
PAGINATION_MAX_PAGE=100000
REPORT_MAX_PERIOD=366d
NOTIFICATION_CONNECT_TIMEOUT=5s
NOTIFICATION_REQUEST_TIMEOUT=10s
NOTIFICATION_POLL_DELAY=5s
NOTIFICATION_REMINDER_CRON=0 0 8 * * *
NOTIFICATION_REMINDER_MAX_BATCHES=100
NOTIFICATION_DEFAULT_SUBJECT=AutoGarage notification
SMTP_CONNECT_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=10000
SMTP_WRITE_TIMEOUT_MS=10000
AUTH_CORS_MAX_AGE=1h

# Workshop policies (bytes; multipart request includes metadata)
WORKSHOP_DEFAULT_SERVICE_MINUTES=60
WORKSHOP_RESERVATION_HOLD=30m
WORKSHOP_MAX_ATTACHMENT_BYTES=15728640
WORKSHOP_MAX_UPLOAD_REQUEST_BYTES=16777216
